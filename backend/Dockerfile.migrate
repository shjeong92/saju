# syntax=docker/dockerfile:1.7
# Drizzle 마이그레이션 전용 이미지. ArgoCD PreSync Hook Job 에서 사용.
# Build context: repo root.
# 예) docker build -f backend/Dockerfile.migrate -t saju-migrate .

FROM oven/bun:1.3-alpine
WORKDIR /app/backend

ENV NODE_ENV=production

COPY backend/package.json backend/bun.lock ./
COPY backend/apps/api/package.json ./apps/api/
COPY backend/apps/worker/package.json ./apps/worker/
COPY backend/packages/ai/package.json ./packages/ai/
COPY backend/packages/db/package.json ./packages/db/
COPY backend/packages/graphql/package.json ./packages/graphql/
COPY backend/packages/saju/package.json ./packages/saju/
COPY backend/packages/shared/package.json ./packages/shared/

# drizzle-kit 은 devDependency 이므로 --production 금지.
RUN bun install --frozen-lockfile

COPY backend/ ./

WORKDIR /app/backend/packages/db

# DATABASE_URL 은 Job spec 에서 env 로 주입.
CMD ["bunx", "drizzle-kit", "migrate"]
