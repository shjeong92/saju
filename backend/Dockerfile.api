# syntax=docker/dockerfile:1.7
# Build context: repo root (workspace 의존성 때문에 backend/ 가 통째로 필요).
# 예) docker build -f backend/Dockerfile.api -t saju-api .

FROM oven/bun:1.1-alpine AS deps
WORKDIR /app

# Workspace manifest 전체를 먼저 복사 → install 캐시 효율 ↑
COPY backend/package.json backend/bun.lock ./backend/
COPY backend/apps/api/package.json ./backend/apps/api/
COPY backend/apps/worker/package.json ./backend/apps/worker/
COPY backend/packages/ai/package.json ./backend/packages/ai/
COPY backend/packages/db/package.json ./backend/packages/db/
COPY backend/packages/graphql/package.json ./backend/packages/graphql/
COPY backend/packages/saju/package.json ./backend/packages/saju/
COPY backend/packages/shared/package.json ./backend/packages/shared/

WORKDIR /app/backend
RUN bun install --frozen-lockfile

# ---- runtime ----
FROM oven/bun:1.1-alpine AS runtime
WORKDIR /app/backend

# tini 같은 init 없이 Bun 자체가 SIGTERM/SIGINT를 받게 둔다 (apps/api/src/index.ts 에서 처리).
ENV NODE_ENV=production

# deps stage 의 node_modules + 소스 복사
COPY --from=deps /app/backend/node_modules ./node_modules
COPY backend/ ./

# Bun 이 ts 를 그대로 실행하므로 별도 build step 없음.
USER bun
EXPOSE 4000

CMD ["bun", "run", "apps/api/src/index.ts"]
