{
  "name": "@saju/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "bun --env-file=../../.env x drizzle-kit generate",
    "db:push": "bun --env-file=../../.env x drizzle-kit push",
    "db:migrate": "bun --env-file=../../.env x drizzle-kit migrate",
    "db:studio": "bun --env-file=../../.env x drizzle-kit studio",
    "db:smoke": "bun --env-file=../../.env run src/scripts/smoke.ts"
  },
  "dependencies": {
    "@saju/shared": "workspace:*",
    "drizzle-orm": "^0.45.0",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.0"
  }
}
